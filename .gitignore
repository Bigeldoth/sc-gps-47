dist/
build/
*.spec
*.log

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
venv/
env/
.env/
.venv-paddle/

# IDE and Editor files
.vscode/
.idea/
.claude/
*.swp
*.swo

# Collected glyphs (templates are derived and versioned under data/templates/)
data/glyphs/

# ONNX training artifacts (datasets, model checkpoints, font assets)
dataset/
models/*
!models/spacedrive_ocr.onnx
!models/spacedrive_ocr.pt
!models/spacedrive_ocr.classes.json
tools/fonts/

# OS generated files
.DS_Store
Thumbs.db

# Specific to this project
spacedrive.log
user_poi.json

# Runtime logs folder (app log + per-session navigation telemetry) — local-only
logs/

# PaddleOCR diagnostic runs (captured frames + summaries) — local-only
diagnostics/

# Debug OCR captures dumped by capture.py when save_ocr_images=True
debug_capture_*.png

# Test screenshot used for paddle_diagnose (~3 MB binary)
sample.bmp

# Gameplay capture videos used for offline OCR/training datasets — local-only
tests/*.mp4

# Local Python venv (created on demand, never committed)
.venv/

# Local release credentials
.env.local
